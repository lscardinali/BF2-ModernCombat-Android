# R8 keep rules for the release build (AGP passes every file in src/main/keepRules).
#
# SDL3's Java side is reached from native code through JNI by name: its classes, the methods and fields the C side
# looks up, and the native methods it registers must keep their names. The app's own classes need nothing here: the
# manifest keeps the activities and the service, and no native code calls into them.
-keep class org.libsdl.app.** { *; }
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}
# SDLActivity's subclass: SDL calls getLibraries() and friends on it by name
-keep class com.lscardinali.bf2mc.MainActivity { *; }
