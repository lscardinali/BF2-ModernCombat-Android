<?xml version="1.0" encoding="utf-8"?>
<!-- home and settings buttons: a bright outline on the focused one, so gamepad focus is obvious -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FF202020" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FF8A1C1C" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FF6A1414" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FF3A3A3A" />
            <stroke android:width="1dp" android:color="#FF606060" />
        </shape>
    </item>
</selector>
