<?xml version="1.0" encoding="utf-8"?>
<!-- the launcher screen (HomeActivity): play and settings, or the game import. Touch or gamepad (D-pad moves focus, A presses, B is back) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxWidth="640dp"
            android:text="@string/import_intro"
            android:textColor="#FFDDDDDD"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/home_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="1000"
            android:maxWidth="640dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FFAAAAAA"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/home_primary"
                style="@style/MenuButton"
                android:text="@string/home_play" />

            <Button
                android:id="@+id/home_settings"
                style="@style/MenuButton"
                android:layout_marginStart="24dp"
                android:text="@string/home_settings" />

            <Button
                android:id="@+id/home_quit"
                style="@style/MenuButton"
                android:layout_marginStart="24dp"
                android:text="@string/home_quit" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
