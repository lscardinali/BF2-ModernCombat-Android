<?xml version="1.0" encoding="utf-8"?>
<!-- the settings (SettingsActivity): touch or gamepad (D-pad moves focus, A presses, B is back) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_settings"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/settings_fill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/menu_button"
            android:minHeight="56dp"
            android:nextFocusDown="@+id/settings_split"
            android:paddingHorizontal="24dp"
            android:text="@string/settings_fill"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:text="@string/settings_fill_detail"
            android:textColor="#FFAAAAAA"
            android:textSize="14sp" />

        <Switch
            android:id="@id/settings_split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/menu_button"
            android:minHeight="56dp"
            android:nextFocusUp="@id/settings_fill"
            android:nextFocusDown="@+id/settings_back"
            android:paddingHorizontal="24dp"
            android:text="@string/settings_split"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:text="@string/settings_split_detail"
            android:textColor="#FFAAAAAA"
            android:textSize="14sp" />

        <Button
            android:id="@id/settings_back"
            style="@style/MenuButton"
            android:layout_marginTop="32dp"
            android:nextFocusUp="@id/settings_split"
            android:text="@string/settings_back" />
    </LinearLayout>
</ScrollView>
