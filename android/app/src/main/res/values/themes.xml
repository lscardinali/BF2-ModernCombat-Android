<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Battlefield2ModernCombat" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- HomeActivity and SettingsActivity: dark and fullscreen, like the game they lead to -->
    <style name="Theme.Battlefield2ModernCombat.Menu" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">#FFB02020</item>
    </style>

    <style name="MenuButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">160dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:background">@drawable/menu_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
