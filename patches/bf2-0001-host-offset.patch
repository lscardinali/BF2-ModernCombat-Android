+// --- Frame map ---------------------------------------------------------------------------------
+
+// BF2_DRAW_STACKS=<seconds>: after that long, writes the guest call stack of every draw, clear,
+// resolve and swap of two frames to BF2_DRAW_STACKS_FILE. Each line: kind, render target, count,
+// return addresses (innermost first), read from the guest's back chain.
+namespace {
+std::atomic<int> g_stack_swaps{0};
+void LogGuestStack(const char* kind, PPCContext& ctx, uint32_t device, uint32_t count) {
+  static const char* const after = std::getenv("BF2_DRAW_STACKS");
+  if (!after) return;
+  static const auto start = std::chrono::steady_clock::now() + std::chrono::seconds(std::atoi(after));
+  if (std::chrono::steady_clock::now() < start || g_stack_swaps.load() >= 2) return;
+  static FILE* const out = std::fopen(std::getenv("BF2_DRAW_STACKS_FILE"), "w");
+  if (!out) return;
+  std::fprintf(out, "%s rt=%08X n=%u lr=%08X", kind, Load32(device + bf2n::dev::kColorSurfaces), count,
+               uint32_t(ctx.lr));
+  const uint32_t top = Load32(ctx.r13.u32 + 0x70);  // PCR: the high end of this thread's stack
+  uint32_t frame = ctx.r1.u32;
+  for (int i = 0; i < 24 && frame < top; i++) {
+    uint32_t next = Load32(frame);
+    if (next <= frame || next > top) break;
+    std::fprintf(out, " %08X", Load32(next - 8));
+    frame = next;
+  }
+  std::fputc('\n', out);
+  if (kind[0] == 'P' && g_stack_swaps.fetch_add(1) == 1) std::fflush(out);
+}
