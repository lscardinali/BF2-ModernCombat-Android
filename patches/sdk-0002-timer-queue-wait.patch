+// Waits on a condition variable until the next timer is due or a new one is queued. disruptorplus's spin_wait_strategy
+// spins, yields and naps 1 ms at a time, which kept a core busy for nothing between the guest's timers; its
+// blocking_wait_strategy passes wait_until's arguments in the wrong order and does not compile once used.
+class BlockingWaitStrategy {
+ public:
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[]) {
+    dp::sequence_t result;
+    std::unique_lock lock(mutex_);
+    cv_.wait(lock, [&] { return Ready(sequence, count, sequences, result); });
+    return result;
+  }
+  template <typename Rep, typename Period>
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[],
+                                      const std::chrono::duration<Rep, Period>& timeout) {
+    return wait_until_published(sequence, count, sequences, std::chrono::steady_clock::now() + timeout);
+  }
+  template <typename Clock, typename Duration>
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[],
+                                      const std::chrono::time_point<Clock, Duration>& until) {
+    dp::sequence_t result;
+    std::unique_lock lock(mutex_);
+    if (until == std::chrono::time_point<Clock, Duration>::max()) {  // no timer queued: a far-off deadline overflows
+      cv_.wait(lock, [&] { return Ready(sequence, count, sequences, result); });
+    } else {
+      cv_.wait_until(lock, until, [&] { return Ready(sequence, count, sequences, result); });
+    }
+    return result;
+  }
+  void signal_all_when_blocking() {
+    std::lock_guard lock(mutex_);  // not between a waiter's check and its wait
+    cv_.notify_all();
+  }
+
+ private:
+  static bool Ready(dp::sequence_t sequence, size_t count, const std::atomic<dp::sequence_t>* const sequences[],
+                    dp::sequence_t& result) {
+    result = dp::minimum_sequence_after(sequence, count, sequences);
+    return dp::difference(result, sequence) >= 0;
+  }
+  std::mutex mutex_;
+  std::condition_variable cv_;
+};
